 "poems": [
  {
   "seq": "1",
   "text": "玉にぬくけふのあやめは宿ことの軒端にかけて誰か見さらん",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "なかきねをたつぬ〓〓とせし程にひきもやられぬあやめ草哉",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "時鳥なけは心そあくかるゝ空たのめすとおもふものから",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "夏山の道もまとひぬ時鳥あかてやみぬるこゑをたつねて",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "なかむれと行かたもなし五月雨のをやまん空の雲間をそまつ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "ともしせぬ木影なけれはをくら山立かくれける鹿そかひなき",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "澤水にすたく螢の光には草の根さしもかくれさりけり",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "久方の月ならねとも草村のほたるそよるの光なりける",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "まつ人のなそありかほに夜を重ね叩く水鷄におとろかるらん",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "待人のなき宿なれと夜もすからたゝく水鷄におとろかれぬる",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "夏草をむすふしるしのなかりせはいかてゆかまし山里のみち",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "見渡せはのへの夏草さをしかのかくるはかりもなりにける哉",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "誰かゝくつけはをきけん夏くれはまつした燃ゆる宿の蚊遣火",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "すくもかきをのれふすふる蚊遣火の煙にむせふ賤のおやなそ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "かきくらし晴間もみえぬ五月雨はたこのもすそをほす程もなし",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "玉にぬく花たちはなをいつしかとけふの袂にかほりかへたり",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "たち花の花吹みたる夕風はむかしをこふるみにそしみける",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "山かつのしつのかきれも卯花のおりにや人のおもしろくみん",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "卯花の盛りならすは山かつの垣ほにたれかこゝろとめまし",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "身にかへて誰かみさらむいつしかと待しあふちの花咲にけり",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "我せこかいつかとまちしかひありて妹にあふちの花咲にけり",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "里とをみ山田のさなへとるほとはしつ心なくものをこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "衣手のぬれゆくまゝにさなへとるたこはかりほに秋を待らむ",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "おく山のしかのたちとをたつぬとてともしにのみもいる心哉",
   "kana": "",
   "speaker": "",
   "page": 32,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
